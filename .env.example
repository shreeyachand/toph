# Supabase (Postgres) — server-only. Only GET /api/dashboard reads these;
# the frontend calls the API and needs no Supabase keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Backwards compat: NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
# (or SUPABASE_ANON_KEY) still work if the server keys above are unset.

# Transcription (server-only) — pick whichever key you have. Unset = uploads
# succeed with transcript null until the parsing pass fills it in.
#   TRANSCRIPTION_PROVIDER=groq|xai (default groq)
# Groq: free tier, no card (2k req/day, 28.8k audio-sec/day, 25 MB/file).
GROQ_API_KEY=
# xAI Grok STT: billed ~$0.10/hr batch from API credits, keyterm biasing.
XAI_API_KEY=
