# Supabase (Postgres) — server-only. Only GET /api/dashboard reads these;
# the frontend calls the API and needs no Supabase keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Backwards compat: NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY
# (or SUPABASE_ANON_KEY) still work if the server keys above are unset.

# Transcription (server-only) — pick whichever key you have. Unset = uploads
# succeed with transcript null until the parsing pass fills it in.
#   TRANSCRIPTION_PROVIDER=groq|xai (default groq)
# Groq: free tier, no card (2k req/day, 28.8k audio-sec/day, 25 MB/file).
GROQ_API_KEY=
# xAI Grok STT: billed ~$0.10/hr batch from API credits, keyterm biasing.
XAI_API_KEY=

# Smart tags (server-only) — a second Groq chat call (structured output) over
# the transcript/note at save time suggests tags in fixed categories
# (pesticide / fertilizer / condition / crop / other) and auto-applies them.
# The same call classifies the log's activity as a strict enum over the
# farm's activity_types catalog (server-validated); when the recorder's
# activity is left on auto-detect, the classified activity is applied and
# flagged as a changeable suggestion.
# Shares GROQ_API_KEY. Optional model override (must support structured
# outputs):
#   TAG_SUGGESTION_MODEL=openai/gpt-oss-120b (default) | llama-3.3-70b-versatile
TAG_SUGGESTION_MODEL=
